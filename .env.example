# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
APP_BASE_URL=http://localhost:9028

# Almacén de cobros: "memoria" (demo, por defecto) o "postgres" (Supabase).
# Cambia a postgres solo después de aplicar las migraciones (npm run db:migrate).
COBROS_STORE=memoria
# Opcional: ruta a la CA de Supabase para verificar el servidor (recomendado en producción).
# DATABASE_SSL_CA_PATH=./supabase-ca.crt
# Solo para pruebas de integración: base LOCAL desechable, nunca Supabase.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trivo_test

# Riel de pagos: "demo" (pago simulado, por defecto) u "open-payments" (pago real).
# Con open-payments NO existe el botón de simular pago y los cobros solo se
# confirman cuando el dinero llega. Guía: docs/OPEN-PAYMENTS.md
COBROS_RAIL=demo
# Wallet address de TU app (la dueña de la llave de Open Payments), con https://
OPEN_PAYMENTS_CLIENT_WALLET_URL=https://ilp.interledger-test.dev/your-wallet
OPEN_PAYMENTS_KEY_ID=
# Ruta al PEM de la llave privada. Nunca va al repo (private.key está en .gitignore).
OPEN_PAYMENTS_PRIVATE_KEY_PATH=./private.key
# Wallet (en COP) donde caen los cobros. Si no se define, la misma de arriba.
# OPEN_PAYMENTS_RECEIVER_WALLET_URL=https://ilp.interledger-test.dev/your-wallet
# Hosts de wallets de pagadores aceptados, separados por comas (defensa contra SSRF).
# OPEN_PAYMENTS_WALLET_HOSTS=ilp.interledger-test.dev

# Firma el código de confirmación que ven vendedor y pagador (mínimo 32 caracteres).
# Obligatorio en producción con open-payments. Genera uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CONFIRMACION_SECRETO=
